---
import Layout from '../layouts/Layout.astro';
import { getAcademicProfile } from '../lib/content.js';

const profile = await getAcademicProfile();
---
<Layout>
  <main class="main-container py-12">
    <header>
      <p class="text-sm uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">CV</p>
      <h1 class="mt-2 text-3xl font-semibold text-slate-900 dark:text-white">{profile.title}</h1>
    </header>

    <section class="mt-8 rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-50 via-white to-sky-50 p-6 dark:border-slate-800 dark:from-slate-900/80 dark:via-slate-900 dark:to-slate-900/70">
      <p class="max-w-3xl text-base leading-7 text-slate-700 dark:text-slate-300">{profile.summary}</p>

      {profile.researchInterests?.length ? (
        <div class="mt-5 flex flex-wrap gap-2">
          {profile.researchInterests.map(item => (
            <span class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200">
              {item}
            </span>
          ))}
        </div>
      ) : null}
    </section>

    <section class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
        <p class="text-xs uppercase tracking-[0.18em] text-violet-700 dark:text-violet-300">Education</p>
        <div class="mt-4 space-y-4">
          {profile.education?.map(item => (
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-950/60">
              <div class="flex items-center justify-between gap-3">
                <h2 class="text-base font-semibold text-slate-900 dark:text-white">{item.degree}</h2>
                <span class="text-[10px] uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">{item.period}</span>
              </div>
              <p class="mt-2 text-sm font-medium text-slate-700 dark:text-slate-200">{item.institution}</p>
              <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{item.details}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
        <p class="text-xs uppercase tracking-[0.18em] text-amber-700 dark:text-amber-300">Highlights</p>
        <div class="mt-4 space-y-4">
          {profile.highlights?.map(item => (
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-950/60">
              <div class="flex items-center justify-between gap-3">
                <h2 class="text-base font-semibold text-slate-900 dark:text-white">{item.title}</h2>
                <span class="text-[10px] uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">{item.period}</span>
              </div>
              <p class="mt-2 text-sm font-medium text-slate-700 dark:text-slate-200">{item.institution}</p>
              <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{item.details}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
