---
import Layout from '../layouts/Layout.astro';
import { getInnovatrixProfile } from '../lib/content.js';

const profile = await getInnovatrixProfile();
const visibleSections = profile.enabled === false ? [] : (profile.sections || []);
---
<Layout>
  <main class="main-container py-12">
    {profile.enabled === false ? (
      <section class="rounded-xl border border-slate-200 bg-white p-8 text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300">
        <h1 class="text-3xl font-semibold text-slate-900 dark:text-white">Innovatrix is currently hidden</h1>
        <p class="mt-3">This section is disabled in the content configuration.</p>
      </section>
    ) : (
      <>
        <header class="rounded-2xl border border-emerald-200 bg-gradient-to-br from-emerald-50 via-white to-sky-50 p-6 dark:border-emerald-900/60 dark:from-emerald-950/70 dark:via-slate-900 dark:to-sky-950/60">
          <p class="text-sm uppercase tracking-[0.18em] text-emerald-600 dark:text-emerald-300">Entrepreneurship</p>
          <h1 class="mt-3 text-4xl font-semibold text-slate-900 dark:text-white">{profile.name}</h1>
          <p class="mt-3 max-w-2xl text-lg text-slate-700 dark:text-slate-300">{profile.tagline}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            {profile.website ? <a href={profile.website} target="_blank" rel="noreferrer" class="rounded-md bg-emerald-600 px-4 py-2 text-white hover:bg-emerald-500">Website</a> : null}
            {profile.instagram ? <a href={profile.instagram} target="_blank" rel="noreferrer" class="rounded-md border border-slate-300 px-4 py-2 text-slate-800 hover:border-emerald-500 hover:text-emerald-600 dark:border-slate-700 dark:text-slate-200 dark:hover:border-emerald-400 dark:hover:text-emerald-300">Instagram</a> : null}
            {profile.email ? <a href={`mailto:${profile.email}`} class="rounded-md border border-slate-300 px-4 py-2 text-slate-800 hover:border-emerald-500 hover:text-emerald-600 dark:border-slate-700 dark:text-slate-200 dark:hover:border-emerald-400 dark:hover:text-emerald-300">Email</a> : null}
          </div>
        </header>

        <div class="mt-10 space-y-6">
          {visibleSections.map(section => (
            <section class="rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
              <h2 class="text-2xl font-semibold text-slate-900 dark:text-white">{section.title}</h2>

              {section.type === 'hero' ? (
                <p class="mt-4 text-lg text-slate-700 dark:text-slate-300">{section.content}</p>
              ) : null}

              {section.type === 'text' ? (
                <>
                  <p class="mt-4 text-slate-700 dark:text-slate-300">{section.content}</p>
                  {section.highlights?.length ? (
                    <ul class="mt-4 space-y-2 text-slate-600 dark:text-slate-300">
                      {section.highlights.map(item => (
                        <li>• {item}</li>
                      ))}
                    </ul>
                  ) : null}
                </>
              ) : null}

              {section.type === 'list' ? (
                <ul class="mt-4 space-y-3 text-slate-700 dark:text-slate-300">
                  {section.items?.map(item => (
                    <li class="flex items-start gap-3"><span class="mt-1 text-emerald-500">•</span><span>{item}</span></li>
                  ))}
                </ul>
              ) : null}

              {section.type === 'contact' ? (
                <div class="mt-4 flex flex-wrap gap-3">
                  {section.items?.map(item => (
                    <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined} class="rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700 hover:border-emerald-500 hover:text-emerald-600 dark:border-slate-700 dark:text-slate-200 dark:hover:border-emerald-400 dark:hover:text-emerald-300">{item.label}</a>
                  ))}
                </div>
              ) : null}
            </section>
          ))}
        </div>
      </>
    )}
  </main>
</Layout>
