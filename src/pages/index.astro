---
import Layout from '../layouts/Layout.astro';
import { getAllProjects, getAllCourses } from '../lib/content.js';
import { site } from '../config/site';

const featuredProjects = (await getAllProjects()).filter(project => project.featured).slice(0, 3);
const activeCourses = (await getAllCourses()).filter(course => course.active).slice(0, 2);
---
<Layout>
  <main class="main-container py-12">
    <section class="grid gap-8 md:grid-cols-[1.5fr_0.8fr] items-start">
      <div>
        <p class="text-sm uppercase tracking-[0.18em] text-slate-500">{site.title}</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-black">{site.name}</h1>
        <p class="mt-4 text-lg text-slate-700">
          Lecturer, researcher, and software engineer building systems that connect academic rigor with practical engineering.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a href="/academic" class="rounded-md bg-blue-500 px-4 py-2 text-white hover:bg-blue-600">Explore Academic Work</a>
          <a href="/engineering/projects" class="rounded-md border border-slate-300 px-4 py-2 text-slate-800 hover:border-blue-500 hover:text-blue-500">View Engineering Portfolio</a>
        </div>
      </div>

      <aside class="rounded-xl border border-slate-200 bg-slate-50 p-5">
        <h2 class="text-lg font-semibold">Quick focus</h2>
        <ul class="mt-4 space-y-3 text-sm text-slate-700">
          <li>• Teaching and curriculum design</li>
          <li>• Applied software engineering</li>
          <li>• Research systems and data-driven projects</li>
        </ul>
      </aside>
    </section>

    <section class="mt-14">
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-2xl font-semibold">Featured projects</h2>
        <a href="/engineering/projects" class="text-sm text-blue-500 hover:underline">See all</a>
      </div>

      <div class="mt-6 grid gap-5 md:grid-cols-3">
        {featuredProjects.map(project => (
          <article class="rounded-xl border border-slate-200 p-5">
            <p class="text-xs uppercase tracking-[0.16em] text-slate-500">{project.year}</p>
            <h3 class="mt-2 text-xl font-semibold"><a href={`/engineering/projects/${project.slug}`} class="hover:text-blue-500">{project.title}</a></h3>
            <p class="mt-3 text-sm text-slate-700">{project.summary}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-14">
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-2xl font-semibold">Current teaching</h2>
        <a href="/academic" class="text-sm text-blue-500 hover:underline">Academic overview</a>
      </div>

      <div class="mt-6 space-y-4">
        {activeCourses.map(course => (
          <article class="rounded-xl border border-slate-200 p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xl font-semibold">{course.title}</h3>
              <span class="text-xs uppercase tracking-[0.16em] text-slate-500">{course.semester}</span>
            </div>
            <p class="mt-3 text-slate-700">{course.summary}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
