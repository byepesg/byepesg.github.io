---
import Layout from '../layouts/Layout.astro';
import { getAllProjects, getAllCourses, getInnovatrixProfile } from '../lib/content.js';
import { site } from '../config/site';

const featuredProjects = (await getAllProjects()).filter(project => project.featured).slice(0, 3);
const activeCourses = (await getAllCourses()).filter(course => course.active).slice(0, 2);
const innovatrix = await getInnovatrixProfile();
const showInnovatrixHome = innovatrix.enabled !== false && innovatrix.showOnHomepage !== false;
---
<Layout>
  <main class="main-container py-12">
    <section class="grid gap-8 md:grid-cols-[1.5fr_0.85fr] items-start">
      <div>
        <p class="text-sm uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">{site.title}</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-black dark:text-white">{site.name}</h1>
        <p class="mt-4 text-lg text-slate-700 dark:text-slate-300">
          {site.tagline}
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          {site.focusAreas.map(tag => (
            <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs uppercase tracking-[0.12em] text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
              {tag}
            </span>
          ))}
        </div>

        <div class="mt-6 flex flex-wrap gap-4">
          <a href="/academic" class="rounded-md bg-blue-500 px-4 py-2 text-white hover:bg-blue-600">Explore Academic Work</a>
          <a href="/engineering/projects" class="rounded-md border border-slate-300 px-4 py-2 text-slate-800 hover:border-blue-500 hover:text-blue-500 dark:border-slate-700 dark:text-slate-200 dark:hover:border-sky-400 dark:hover:text-sky-300">View Engineering Portfolio</a>
          {showInnovatrixHome ? <a href="/innovatrix" class="rounded-md border border-emerald-300 bg-emerald-50 px-4 py-2 text-emerald-700 hover:border-emerald-500 hover:text-emerald-600 dark:border-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">Visit Innovatrix</a> : null}
        </div>
      </div>

      <div class="space-y-5">
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <img
            src="/images/profile.jpg"
            alt="Sebastián Yepes"
            class="h-80 w-full object-cover"
            onerror="this.onerror=null;this.src='/images/profile-placeholder.svg';"
          />
        </div>
        <aside class="rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/80">
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Current profile</h2>
          <ul class="mt-4 space-y-3 text-sm text-slate-700 dark:text-slate-300">
            <li>• AI systems and applied research</li>
            <li>• MLOps and production-grade engineering</li>
            <li>• Differential privacy and algorithmic foundations</li>
            <li>• Data Structures instruction at UNAL</li>
          </ul>
        </aside>
      </div>
    </section>

    {showInnovatrixHome ? (
      <section class="mt-14 rounded-2xl border border-emerald-200 bg-gradient-to-br from-emerald-50 via-white to-sky-50 p-6 dark:border-emerald-900/60 dark:from-emerald-950/70 dark:via-slate-900 dark:to-sky-950/60">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div>
            <p class="text-xs uppercase tracking-[0.18em] text-emerald-600 dark:text-emerald-300">Entrepreneurship</p>
            <h2 class="mt-2 text-2xl font-semibold text-slate-900 dark:text-white">{innovatrix.name}</h2>
            <p class="mt-2 max-w-2xl text-slate-700 dark:text-slate-300">{innovatrix.tagline}</p>
          </div>
          <a href="/innovatrix" class="inline-flex rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500">Explore Innovatrix</a>
        </div>
      </section>
    ) : null}

    <section class="mt-14 grid gap-5 md:grid-cols-3">
      {site.experience.map(item => (
        <article class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
          <p class="text-xs uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">{item.label}</p>
          <h2 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">{item.title}</h2>
          <p class="mt-3 text-sm text-slate-700 dark:text-slate-300">{item.detail}</p>
        </article>
      ))}
    </section>

    <section class="mt-14">
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-2xl font-semibold text-slate-900 dark:text-white">Featured projects</h2>
        <a href="/engineering/projects" class="text-sm text-blue-500 hover:underline dark:text-sky-300">See all</a>
      </div>

      <div class="mt-6 grid gap-5 md:grid-cols-3">
        {featuredProjects.map(project => (
          <article class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
            <p class="text-xs uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">{project.year}</p>
            <h3 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white"><a href={`/engineering/projects/${project.slug}`} class="hover:text-blue-500 dark:hover:text-sky-300">{project.title}</a></h3>
            <p class="mt-3 text-sm text-slate-700 dark:text-slate-300">{project.summary}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-14 grid gap-5 md:grid-cols-[1.2fr_0.8fr]">
      <div class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-2xl font-semibold text-slate-900 dark:text-white">Academic background</h2>
        <ul class="mt-4 space-y-3 text-slate-700 dark:text-slate-300">
          {site.education.map(item => (
            <li>• {item}</li>
          ))}
        </ul>
      </div>

      <div class="rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/80">
        <h2 class="text-2xl font-semibold text-slate-900 dark:text-white">This semester</h2>
        <p class="mt-3 text-slate-700 dark:text-slate-300">
          Teaching Data Structures and maintaining a private course-material flow for enrolled students through Google Drive folders and learning resources.
        </p>
        <a href="/academic" class="mt-4 inline-block text-sm text-blue-500 hover:underline dark:text-sky-300">View academic page</a>
      </div>
    </section>

    <section class="mt-14">
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-2xl font-semibold text-slate-900 dark:text-white">Current teaching</h2>
        <a href="/academic" class="text-sm text-blue-500 hover:underline dark:text-sky-300">Academic overview</a>
      </div>

      <div class="mt-6 space-y-4">
        {activeCourses.map(course => (
          <article class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xl font-semibold text-slate-900 dark:text-white">{course.title}</h3>
              <span class="text-xs uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">{course.semester}</span>
            </div>
            <p class="mt-3 text-slate-700 dark:text-slate-300">{course.summary}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
