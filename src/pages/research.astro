---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import { getAllPublications, getAllResearchDocuments } from '../lib/content.js';

const publications = (await getAllPublications()).sort((a, b) => Number(b.year || 0) - Number(a.year || 0));
const researchDownloads = (await getAllResearchDocuments()).sort((a, b) => Number(b.year || 0) - Number(a.year || 0));

const pdfDir = path.resolve('./public/pdfs');
const hasPdf = fileName => fs.existsSync(path.join(pdfDir, fileName));
researchDownloads.forEach(doc => {
  doc.hasLocalPdf = Boolean(doc.localFile && hasPdf(doc.localFile));
  doc.localHref = doc.localFile ? `/pdfs/${doc.localFile}` : null;
});
---
<Layout>
  <main class="main-container py-12">
    <header>
      <p class="text-sm uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Research</p>
      <h1 class="mt-2 text-3xl font-semibold text-slate-900 dark:text-white">Research and publications</h1>
    </header>

    <section class="mt-8 rounded-xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900/80">
      <h2 class="text-xl font-semibold text-slate-900 dark:text-white">Research agenda</h2>
      <p class="mt-3 text-slate-700 dark:text-slate-300">
        Sebastián Yepes works at the intersection of AI systems, differential privacy, cryptography, compression algorithms, and production-oriented software engineering.
      </p>
    </section>

    <section class="mt-8 rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">PDF library</p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-900 dark:text-white">Downloadable papers and working documents</h2>
        </div>
      </div>

      <div class="mt-4 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-700 dark:border-slate-700 dark:bg-slate-950/60 dark:text-slate-300">
        Put PDFs inside <span class="font-mono text-sky-600 dark:text-sky-400">/public/pdfs</span> and then link them from this page. This keeps the public research library easy to update without cluttering the source content.
      </div>

      <div class="mt-5 grid gap-4 md:grid-cols-3">
        {researchDownloads.map(doc => (
          <article class="rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-950/70">
            <div class="flex items-center justify-between gap-3">
              <span class="text-[10px] uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">{doc.year}</span>
            </div>
            <h3 class="mt-2 text-base font-semibold text-slate-900 dark:text-white">{doc.title}</h3>
            <p class="mt-2 text-sm text-slate-700 dark:text-slate-300">{doc.summary}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              <a href={doc.externalHref} target="_blank" rel="noreferrer" class="rounded-md bg-blue-500 px-3 py-2 text-xs font-medium text-white hover:bg-blue-600 dark:bg-sky-500 dark:hover:bg-sky-400">External link</a>
              {doc.hasLocalPdf ? (
                <a href={doc.localHref} class="rounded-md border border-slate-300 px-3 py-2 text-xs font-medium text-slate-700 hover:border-blue-500 hover:text-blue-500 dark:border-slate-700 dark:text-slate-200 dark:hover:border-sky-400 dark:hover:text-sky-300">Local PDF</a>
              ) : null}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-semibold text-slate-900 dark:text-white">Featured publications</h2>
      <div class="mt-6 space-y-5">
        {publications.map(pub => (
          <article class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
            <div class="flex items-center justify-between gap-4">
              <h3 class="text-xl font-semibold text-slate-900 dark:text-white">{pub.title}</h3>
              <span class="text-xs uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">{pub.year}</span>
            </div>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{pub.venue} · {pub.type}</p>
            <p class="mt-3 text-slate-700 dark:text-slate-300">{pub.authors?.join(', ')}</p>
            <div class="mt-4 flex flex-wrap gap-3">
              {Object.entries(pub.links || {}).map(([label, href]) => (
                <a href={href} target="_blank" rel="noreferrer" class="text-sm text-blue-500 underline dark:text-sky-300">{label}</a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
