---
import Layout from '../layouts/Layout.astro';

const publicationModules = await Astro.glob('../content/publications/*.md');
const publications = publicationModules.map(module => ({
  ...module.frontmatter,
  slug: module.frontmatter.slug || module.file.split('/').pop().replace(/\.md$/, '')
})).sort((a, b) => Number(b.year || 0) - Number(a.year || 0));
---
<Layout>
  <main class="main-container py-12">
    <header>
      <p class="text-sm uppercase tracking-[0.18em] text-slate-500">Research</p>
      <h1 class="mt-2 text-3xl font-semibold">Research and publications</h1>
    </header>

    <section class="mt-8 rounded-xl border border-slate-200 p-6 bg-slate-50">
      <h2 class="text-xl font-semibold">Research agenda</h2>
      <p class="mt-3 text-slate-700">
        Sebastián Yepes works at the intersection of AI systems, differential privacy, cryptography, compression algorithms, and production-oriented software engineering.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-semibold">Featured publications</h2>
      <div class="mt-6 space-y-5">
        {publications.map(pub => (
          <article class="rounded-xl border border-slate-200 p-5">
            <div class="flex items-center justify-between gap-4">
              <h3 class="text-xl font-semibold">{pub.title}</h3>
              <span class="text-xs uppercase tracking-[0.16em] text-slate-500">{pub.year}</span>
            </div>
            <p class="mt-2 text-sm text-slate-600">{pub.venue} · {pub.type}</p>
            <p class="mt-3 text-slate-700">{pub.authors?.join(', ')}</p>
            <div class="mt-4 flex flex-wrap gap-3">
              {Object.entries(pub.links || {}).map(([label, href]) => (
                <a href={href} target="_blank" rel="noreferrer" class="text-sm text-blue-500 underline">{label}</a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
