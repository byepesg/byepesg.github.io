---
import Layout from '../../layouts/Layout.astro';
import { getAcademicProfile, getAllCourses } from '../../lib/content.js';

const profile = await getAcademicProfile();
const courses = (await getAllCourses()).sort((a, b) => {
  return (b.semester || '').localeCompare(a.semester || '') || a.title.localeCompare(b.title);
});

function groupCourseResources(resources = []) {
  const groupMap = [
    { key: 'grades', label: 'Notas y calificaciones', match: /(nota|calif|score|grades)/i },
    { key: 'syllabus', label: 'Syllabus y documentación', match: /(syllabus|cronograma|document|programa)/i },
    { key: 'resources', label: 'Recursos del curso', match: /(recurso|material)/i },
    { key: 'classes', label: 'Material de clases', match: /(clase|lecture|class|teoría)/i },
    { key: 'exams', label: 'Exámenes', match: /(examen|quiz)/i },
    { key: 'project', label: 'Proyecto', match: /(proyecto|project)/i },
    { key: 'workshops', label: 'Talleres', match: /(taller|workshop)/i }
  ];

  return groupMap
    .map(group => ({
      label: group.label,
      items: resources.filter(resource => group.match.test(resource.label || ''))
    }))
    .filter(group => group.items.length > 0);
}
---
<Layout>
  <main class="main-container py-12">
    <header>
      <p class="text-sm uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Academic</p>
      <h1 class="mt-2 text-3xl font-semibold text-slate-900 dark:text-white">Teaching, research, and academic trajectory</h1>
    </header>

    <section class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900/80">
      <h2 class="text-xl font-semibold text-slate-900 dark:text-white">Academic</h2>
      <div class="mt-5 grid gap-6 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
          <p class="text-xs uppercase tracking-[0.18em] text-violet-700 dark:text-violet-300">Education</p>
          <div class="mt-4 space-y-4">
            {profile.education?.map(item => (
              <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-950/60">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="text-base font-semibold text-slate-900 dark:text-white">{item.degree}</h3>
                  <span class="text-[10px] uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">{item.period}</span>
                </div>
                <p class="mt-2 text-sm font-medium text-slate-700 dark:text-slate-200">{item.institution}</p>
                <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{item.details}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
          <p class="text-xs uppercase tracking-[0.18em] text-amber-700 dark:text-amber-300">Highlights</p>
          <div class="mt-4 space-y-4">
            {profile.highlights?.map(item => (
              <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-950/60">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="text-base font-semibold text-slate-900 dark:text-white">{item.title}</h3>
                  <span class="text-[10px] uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">{item.period}</span>
                </div>
                <p class="mt-2 text-sm font-medium text-slate-700 dark:text-slate-200">{item.institution}</p>
                <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{item.details}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold text-slate-900 dark:text-white">Research & Academic Work</h2>
      <p class="mt-3 text-slate-700 dark:text-slate-300">
        My research focuses on EEG-based neurological outcome prediction, foundation models for biomedical signals, and privacy-aware machine learning. Visit the Research page for publications, ongoing projects, and details about lab activities.
      </p>

      <div class="mt-4">
        <a href="/research" class="inline-block rounded-md bg-blue-500 px-4 py-2 text-white hover:bg-blue-600">View research</a>
        <a href="/teaching" class="ml-3 inline-block rounded-md border border-slate-300 px-4 py-2 text-slate-800 hover:border-blue-500 hover:text-blue-500 dark:border-slate-700 dark:text-slate-200 dark:hover:border-sky-400 dark:hover:text-sky-300">Teaching (course list)</a>
      </div>
    </section>
  </main>
</Layout>
