---
import '../styles/global.css';
import { site } from '../config/site';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={site.description} />
    <title>{site.name}</title>
  </head>
  <body class="bg-white text-black font-sans">
    <header class="border-b border-slate-200 py-4">
      <div class="main-container flex items-center justify-between gap-4">
        <a href="/" class="font-medium text-black">{site.name}</a>
        <nav class="flex flex-wrap items-center gap-4 text-sm text-slate-700">
          {site.nav.map(item => (
            <a href={item.href} class="hover:text-blue-500">{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <slot />

    <footer class="border-t border-slate-200 mt-12 py-8">
      <div class="main-container flex flex-col gap-4 md:flex-row md:items-center md:justify-between text-sm text-slate-600">
        <p>© {new Date().getFullYear()} {site.name}</p>
        <div class="flex flex-wrap gap-4">
          {Object.entries(site.socials).map(([label, href]) => (
            <a href={href} target="_blank" rel="noreferrer" class="hover:text-blue-500 capitalize">{label}</a>
          ))}
        </div>
      </div>
    </footer>
  </body>
</html>
